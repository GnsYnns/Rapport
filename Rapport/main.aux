\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Empreinte carbone d'Iveco Group en 2025~: répartition des émissions Scope 1, 2 et 3 en échelle logarithmique. Le Scope 3 domine avec 99,5\,\% du total, ce qui met en évidence la prédominance de la phase d'usage des véhicules vendus.}}{22}{figure.3}\protected@file@percent }
\newlabel{fig:ghg}{{3}{22}{Empreinte carbone d'Iveco Group en 2025~: répartition des émissions Scope 1, 2 et 3 en échelle logarithmique. Le Scope 3 domine avec 99,5\,\% du total, ce qui met en évidence la prédominance de la phase d'usage des véhicules vendus}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Mix énergétique d'Iveco Group en 2025. Les énergies renouvelables atteignent 35,2\,\%, en hausse grâce aux achats d'électricité verte et aux investissements en efficacité.}}{22}{figure.4}\protected@file@percent }
\newlabel{fig:energie}{{4}{22}{Mix énergétique d'Iveco Group en 2025. Les énergies renouvelables atteignent 35,2\,\%, en hausse grâce aux achats d'électricité verte et aux investissements en efficacité}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Évolution du taux de fréquence de blessures par million d'heures (2019-2025) et cible 2026. La baisse de 51\,\% entre 2019 et 2025 dépasse déjà l'objectif de -40\,\% fixé pour 2026.}}{23}{figure.5}\protected@file@percent }
\newlabel{fig:blessures}{{5}{23}{Évolution du taux de fréquence de blessures par million d'heures (2019-2025) et cible 2026. La baisse de 51\,\% entre 2019 et 2025 dépasse déjà l'objectif de -40\,\% fixé pour 2026}{figure.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Répartition du budget communautaire d'Iveco Group en 2025. Les dons en numéraire dominent (91\,\%), complétés par des contributions en nature, en temps et par les frais de gestion.}}{23}{figure.6}\protected@file@percent }
\newlabel{fig:budgetcom}{{6}{23}{Répartition du budget communautaire d'Iveco Group en 2025. Les dons en numéraire dominent (91\,\%), complétés par des contributions en nature, en temps et par les frais de gestion}{figure.6}{}}
